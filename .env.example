# Telegram Bot Token - 从 @BotFather 获取
BOT_TOKEN=your_bot_token_here

# 存储频道/群组 ID - 频道必须是私有的，bot 需要是管理员
# 获取方法：将频道消息转发给 @userinfobot，或使用 API
CHANNEL_ID=-1001234567890

# 服务器端口
PORT=3000

# 默认管理员密码（首次启动自动创建 admin 账号时使用）
# 未设置时回退为内置默认口令，部署务必显式设置一个强密码，并在首次登录后于页面修改。
ADMIN_PASSWORD=change_this_strong_password

# 可选：本地 Bot API Server（支持上传大文件）
# LOCAL_BOT_API_URL=http://localhost:8081
